# ─── Application ────────────────────────────────────────────────────────────
# URL publique de l'application (domaine final en production).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Better Auth ────────────────────────────────────────────────────────────
# Même valeur que NEXT_PUBLIC_APP_URL. Sur Vercel, les URL de preview sont
# automatiquement ajoutées aux origines de confiance (VERCEL_URL…).
BETTER_AUTH_URL=http://localhost:3000
# Secret long et aléatoire (ex. : openssl rand -base64 48). Sert aussi à dériver
# les liens publics (QR code, écran géant) : le changer invalide ces liens.
BETTER_AUTH_SECRET=change-me-with-a-long-random-secret

# ─── Base de données : Neon PostgreSQL ─────────────────────────────────────
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# ─── Temps réel : Ably (optionnel) ─────────────────────────────────────────
# Clé serveur (capacités publish + subscribe). Les navigateurs reçoivent des jetons
# limités à l'abonnement d'un seul événement via /api/realtime/token.
# Sans clé, les écrans se synchronisent automatiquement en HTTP (~1,5 s).
ABLY_API_KEY=

# ─── Comptes de développement (npm run db:seed) ────────────────────────────
SEED_SUPER_ADMIN_EMAIL=admin@fundraising-live.test
SEED_SUPER_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=

# ─── Stockage S3 compatible (prévu, non requis) ────────────────────────────
# Le MVP stocke logos et images de fond en base (table media_asset, 2 Mo max).
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
