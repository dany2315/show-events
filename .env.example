# App
# In production on Vercel, set this to your final domain when you have one.
# Before that, Better Auth can fall back to VERCEL_URL automatically.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Better Auth
# Optional on Vercel if VERCEL_URL is available, recommended once domain is fixed.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-me-with-a-long-random-secret

# Option B cible pour la production
# Neon PostgreSQL
DATABASE_URL=postgresql://user:password@ep-example.neon.tech/show_events?sslmode=require

# Ably realtime
ABLY_API_KEY=your-ably-api-key
NEXT_PUBLIC_ABLY_CLIENT_KEY=your-ably-public-client-key

# Stockage logos et medias, a brancher plus tard
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
